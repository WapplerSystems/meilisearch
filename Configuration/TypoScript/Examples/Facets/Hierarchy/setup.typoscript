# Enable a hierarchy facet on the field "rootline"

lib.tx_t3meilisearch.pagetitle = HMENU
lib.tx_t3meilisearch.pagetitle {
  special = list
  special.value.current = 1
  1 = TMENU
  1 {
    NO {
      doNotLinkIt = 1
    }
  }
}

plugin.tx_t3meilisearch.search.faceting = 1
plugin.tx_t3meilisearch.search.faceting.facets {
  pageHierarchy {
    field = rootline
    label = Rootline
    type = hierarchy
    partialName = Rootline
  }
}
